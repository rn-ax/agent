#!/usr/bin/env python3
"""Find Paperless documents with bad OCR through the REST API.

    ocr-scan [--min-known 0.55] [--confirm-type NAME ...] [--report FILE]

Reads every document, scores its stored OCR text, and lists the ones that fail. It changes
nothing in Paperless: tagging is a separate step (`pl-tags --add ocr-bad ID ...`). The flagged
list is written to a report file (ocr-cache/flagged.csv next to this script, gitignored, unless
--report is given) and its ids are in the printed context.

Heuristics, all language-agnostic and computed on the `content` field (a document is flagged when
any fails; every reason is reported):
  no_text           under 20 characters (plain-text documents are exempt)
  broken_encoding   control characters above 2% of the text (a shifted embedded text layer)
  unknown_words     at least 15 letter tokens and known_ratio below --min-known, where known_ratio
                    is the share of tokens (3+ letters) that occur in at least 3 other documents.
                    Real words repeat across a library, OCR garbage doesn't.
  thin_text         under 15 tokens and under 150 characters per page
  fragmented        over 60% of the letter-bearing words have 2 letters or fewer (20+ words):
                    spaced-out letters such as "Samue l Valen t i n", which known_ratio misses

Rules that skip a document before any scoring, in this order:
  - Inbox: a document carrying an inbox tag (Paperless's own is_inbox_tag flag) is skipped, because
    it is not categorised yet and its metadata can't be trusted.
  - Tagged: a document carrying any tag under the parent tag `agent-ocr` (ocr-ok, ocr-bad,
    ocr-fixed, ocr-skipped) is skipped, because its OCR has already been dealt with or handed over.
  - Type: a document of a confirmed type ("Pyssel / Teckning": children's drawings rarely have
    meaningful text; add more with --confirm-type) is skipped.

The scan keeps no state of its own: what has been dealt with is recorded as tags in Paperless.
Every scan fetches all text, because known_ratio compares a document with the whole library.

The scan prints one JSON context on stdout (inputs, each step, counts and the ids the next
step needs) and exits 0, or 1 with an `error` in the context saying which step failed and what had
been done by then. Credentials: see paperless_lib.py.
"""
import argparse
import collections
import csv
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from paperless_lib import Api, Context, Failure

HERE = Path(__file__).resolve().parent
CACHE = HERE / "ocr-cache"
PARENT_TAG = "agent-ocr"
FLAGGED = CACHE / "flagged.csv"

DEFAULT_CONFIRM_TYPES = ["Pyssel / Teckning"]
MIN_DF = 3
FIELDS = "id,title,content,page_count,mime_type,document_type,tags"
TOKEN_RE = re.compile(r"[^\W\d_]{3,}", re.U)
CTRL_RE = re.compile(r"[\x00-\x08\x0b\x0d-\x1f]")


def agent_tag_ids(api):
    """Ids of the parent tag and every tag below it."""
    tags = api.get("/tags/?page_size=1000")["results"]
    parent = next((t["id"] for t in tags if t["name"] == PARENT_TAG), None)
    if parent is None:
        raise Failure(f"no tag named {PARENT_TAG!r}")
    ids, grew = {parent}, True
    while grew:
        grew = False
        for t in tags:
            if t.get("parent") in ids and t["id"] not in ids:
                ids.add(t["id"])
                grew = True
    return ids


def inbox_tag_ids(api):
    # the API ignores an is_inbox_tag filter, so read the flag on each tag
    return {t["id"] for t in api.get("/tags/?page_size=1000")["results"] if t.get("is_inbox_tag")}


def type_ids(api, names):
    types = {t["name"].casefold(): t["id"] for t in api.get("/document_types/?page_size=1000")["results"]}
    found = {n: types[n.casefold()] for n in names if n.casefold() in types}
    return found, [n for n in names if n.casefold() not in types]


def score(doc, df, min_known):
    text = doc.get("content") or ""
    n = len(text.strip())
    pages = max(doc.get("page_count") or 1, 1)
    toks = [t.lower() for t in TOKEN_RE.findall(text)]
    own = set(toks)
    known = sum(1 for t in toks if df[t] - (1 if t in own else 0) >= MIN_DF)
    ratio = known / len(toks) if toks else 0.0
    ctrl = len(CTRL_RE.findall(text)) / max(len(text), 1)
    words = [w for w in text.split() if any(c.isalpha() for c in w)]
    frag = sum(1 for w in words if sum(c.isalpha() for c in w) <= 2) / len(words) if words else 0.0
    reasons = []
    if doc.get("mime_type") != "text/plain":
        if n < 20:
            reasons.append("no_text")
        else:
            if ctrl > 0.02:
                reasons.append("broken_encoding")
            if len(toks) >= 15 and ratio < min_known:
                reasons.append("unknown_words")
            if len(toks) < 15 and n / pages < 150:
                reasons.append("thin_text")
            if len(words) >= 20 and frag > 0.6:
                reasons.append("fragmented")
    return dict(reasons=reasons, known_ratio=round(ratio, 3), tokens=len(toks), chars=n,
                chars_per_page=round(n / pages), ctrl=round(ctrl, 4), frag=round(frag, 3))


def cmd_scan(ctx, a):
    api = Api()
    types, unknown = type_ids(api, DEFAULT_CONFIRM_TYPES + (a.confirm_type or []))
    ctx.step("confirm_types", resolved=list(types), unknown=unknown)
    inbox_tags, agent_tags = inbox_tag_ids(api), agent_tag_ids(api)
    docs = api.documents("", FIELDS)
    ctx.step("fetched", documents=len(docs), inbox_tag_ids=sorted(inbox_tags))
    df = collections.Counter()
    for d in docs:
        df.update(set(t.lower() for t in TOKEN_RE.findall(d.get("content") or "")))

    counts = {k: 0 for k in ('inbox', 'tagged', 'confirmed_by_type', 'scored')}
    flagged = []
    for d in docs:
        if inbox_tags & set(d.get("tags") or []):
            counts["inbox"] += 1
        elif agent_tags & set(d.get("tags") or []):
            counts["tagged"] += 1
        elif d.get("document_type") in types.values():
            counts["confirmed_by_type"] += 1
        else:
            s = score(d, df, a.min_known)
            counts["scored"] += 1
            if s["reasons"]:
                flagged.append({"id": d["id"], "title": d["title"], "reasons": "+".join(s["reasons"]),
                                **{k: v for k, v in s.items() if k != "reasons"}})
    by_reason = collections.Counter(r for f in flagged for r in f["reasons"].split("+"))
    ctx.step("scored", **counts, flagged=len(flagged))

    report = Path(a.report) if a.report else FLAGGED
    report.parent.mkdir(parents=True, exist_ok=True)
    cols = ["id", "title", "reasons", "known_ratio", "tokens", "chars", "chars_per_page", "ctrl", "frag"]
    with open(report, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=cols)
        w.writeheader()
        w.writerows(flagged)
    ctx.set(documents=len(docs), **counts, passed=counts["scored"] - len(flagged), flagged=len(flagged),
            by_reason=dict(by_reason), flagged_ids=[f["id"] for f in flagged], report=str(report),
            unknown_confirm_types=unknown)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--confirm-type", action="append", help="also skip documents of this type (repeatable)")
    ap.add_argument("--min-known", type=float, default=0.55, help="known-word ratio below which text is flagged")
    ap.add_argument("--report", help="write the flagged list here instead of ocr-cache/flagged.csv")
    a = ap.parse_args()
    Context("ocr-scan", **vars(a)).run(lambda ctx: cmd_scan(ctx, a))


if __name__ == "__main__":
    main()
