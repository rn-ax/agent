#!/usr/bin/env python3
"""Find Paperless documents with bad OCR through the REST API.

    ocr-scan [scan] [--min-known 0.55] [--confirm-type NAME ...] [--report FILE]
        Read every document, score its stored OCR text, and list the ones that fail.
    ocr-scan ok [ID|A-B ...] [--tag NAME] [--type NAME] [--dry-run]
        Log documents as confirmed OK. The only command that writes (one append to the confirmed list).

`scan` reads only. It writes the flagged list to a report file (ocr-cache/flagged.csv unless
--report is given) and never changes Paperless or the confirmed list. Tagging flagged documents
is a separate step: `pl-tags --add bad-ocr ID ...`.

Heuristics, all language-agnostic and computed on the `content` field (a document is flagged when
any fails; every reason is reported):
  no_text           under 20 characters (plain-text documents are exempt)
  broken_encoding   control characters above 2% of the text (a shifted embedded text layer)
  unknown_words     at least 15 letter tokens and known_ratio below --min-known, where known_ratio
                    is the share of tokens (3+ letters) that occur in at least 3 other documents.
                    Real words repeat across a library, OCR garbage doesn't.
  thin_text         under 15 tokens and under 150 characters per page
  fragmented        over 60% of the letter-bearing words have 2 letters or fewer (20+ words):
                    spaced-out letters such as "Samue l Valen t i n", which known_ratio misses

Two rules decide before any scoring, in this order:
  - Inbox: a document carrying an inbox tag (Paperless's own is_inbox_tag flag) is skipped
    entirely, because it is not categorised yet and its metadata can't be trusted.
  - Confirmed: a document in the confirmed list, or of a confirmed type ("Pyssel / Teckning":
    children's drawings rarely have meaningful text; add more with --confirm-type), is skipped.

The only state is ocr-cache/confirmed_ok.csv next to this script (gitignored, local to this
machine): document ids, one per line, that we are happy with. In the file = skipped by scans;
not in the file = scored every run, even if it passes. Nothing is recorded about passing documents.
Every scan fetches all text, because known_ratio compares a document with the whole library.

Every command prints one JSON context on stdout (inputs, each step, counts and the ids the next
step needs) and exits 0, or 1 with an `error` in the context saying which step failed and what had
been done by then. Credentials: see paperless_lib.py.
"""
import argparse
import collections
import csv
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from paperless_lib import Api, Context, Failure

HERE = Path(__file__).resolve().parent
CACHE = HERE / "ocr-cache"
CONFIRMED = CACHE / "confirmed_ok.csv"
FLAGGED = CACHE / "flagged.csv"

DEFAULT_CONFIRM_TYPES = ["Pyssel / Teckning"]
MIN_DF = 3
FIELDS = "id,title,content,page_count,mime_type,document_type,tags"
TOKEN_RE = re.compile(r"[^\W\d_]{3,}", re.U)
CTRL_RE = re.compile(r"[\x00-\x08\x0b\x0d-\x1f]")


def load_confirmed():
    if not CONFIRMED.exists():
        return set()
    return {int(x) for x in CONFIRMED.read_text().split() if x.isdigit()}


def inbox_tag_ids(api):
    # the API ignores an is_inbox_tag filter, so read the flag on each tag
    return {t["id"] for t in api.get("/tags/?page_size=1000")["results"] if t.get("is_inbox_tag")}


def type_ids(api, names):
    types = {t["name"].casefold(): t["id"] for t in api.get("/document_types/?page_size=1000")["results"]}
    found = {n: types[n.casefold()] for n in names if n.casefold() in types}
    return found, [n for n in names if n.casefold() not in types]


def score(doc, df, min_known):
    text = doc.get("content") or ""
    n = len(text.strip())
    pages = max(doc.get("page_count") or 1, 1)
    toks = [t.lower() for t in TOKEN_RE.findall(text)]
    own = set(toks)
    known = sum(1 for t in toks if df[t] - (1 if t in own else 0) >= MIN_DF)
    ratio = known / len(toks) if toks else 0.0
    ctrl = len(CTRL_RE.findall(text)) / max(len(text), 1)
    words = [w for w in text.split() if any(c.isalpha() for c in w)]
    frag = sum(1 for w in words if sum(c.isalpha() for c in w) <= 2) / len(words) if words else 0.0
    reasons = []
    if doc.get("mime_type") != "text/plain":
        if n < 20:
            reasons.append("no_text")
        else:
            if ctrl > 0.02:
                reasons.append("broken_encoding")
            if len(toks) >= 15 and ratio < min_known:
                reasons.append("unknown_words")
            if len(toks) < 15 and n / pages < 150:
                reasons.append("thin_text")
            if len(words) >= 20 and frag > 0.6:
                reasons.append("fragmented")
    return dict(reasons=reasons, known_ratio=round(ratio, 3), tokens=len(toks), chars=n,
                chars_per_page=round(n / pages), ctrl=round(ctrl, 4), frag=round(frag, 3))


def cmd_scan(ctx, a):
    api = Api()
    types, unknown = type_ids(api, DEFAULT_CONFIRM_TYPES + (a.confirm_type or []))
    ctx.step("confirm_types", resolved=list(types), unknown=unknown)
    inbox_tags = inbox_tag_ids(api)
    docs = api.documents("", FIELDS)
    ctx.step("fetched", documents=len(docs), inbox_tag_ids=sorted(inbox_tags))
    confirmed = load_confirmed()
    df = collections.Counter()
    for d in docs:
        df.update(set(t.lower() for t in TOKEN_RE.findall(d.get("content") or "")))

    counts = {k: 0 for k in ('inbox', 'confirmed_in_list', 'confirmed_by_type', 'scored')}
    flagged = []
    for d in docs:
        if inbox_tags & set(d.get("tags") or []):
            counts["inbox"] += 1
        elif d["id"] in confirmed:
            counts["confirmed_in_list"] += 1
        elif d.get("document_type") in types.values():
            counts["confirmed_by_type"] += 1
        else:
            s = score(d, df, a.min_known)
            counts["scored"] += 1
            if s["reasons"]:
                flagged.append({"id": d["id"], "title": d["title"], "reasons": "+".join(s["reasons"]),
                                **{k: v for k, v in s.items() if k != "reasons"}})
    by_reason = collections.Counter(r for f in flagged for r in f["reasons"].split("+"))
    ctx.step("scored", **counts, flagged=len(flagged))

    report = Path(a.report) if a.report else FLAGGED
    report.parent.mkdir(parents=True, exist_ok=True)
    cols = ["id", "title", "reasons", "known_ratio", "tokens", "chars", "chars_per_page", "ctrl", "frag"]
    with open(report, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=cols)
        w.writeheader()
        w.writerows(flagged)
    ctx.set(documents=len(docs), **counts, passed=counts["scored"] - len(flagged), flagged=len(flagged),
            by_reason=dict(by_reason), flagged_ids=[f["id"] for f in flagged], report=str(report),
            unknown_confirm_types=unknown)


def parse_ids(items):
    ids = set()
    for item in items:
        for part in item.split(","):
            lo, _, hi = part.partition("-")
            ids.update(range(int(lo), int(hi or lo) + 1))
    return ids


def cmd_ok(ctx, a):
    api = Api()
    ids = parse_ids(a.ids)
    if a.tag:
        tag = api.tag(a.tag)
        found = {d["id"] for d in api.documents(f"tags__id__all={tag['id']}", "id")}
        ctx.step("from_tag", tag=a.tag, documents=len(found))
        ids |= found
    if a.type:
        types, unknown = type_ids(api, [a.type])
        if unknown:
            raise Failure(f"no document type named {a.type!r}")
        found = {d["id"] for d in api.documents(f"document_type__id={types[a.type]}", "id")}
        ctx.step("from_type", type=a.type, documents=len(found))
        ids |= found
    if not ids:
        raise Failure("no documents selected: give ids, --tag or --type")

    inbox_tags, existing, in_inbox = inbox_tag_ids(api), set(), set()
    ordered = sorted(ids)
    for i in range(0, len(ordered), 100):
        for d in api.documents("id__in=" + ",".join(map(str, ordered[i:i + 100])), "id,tags"):
            existing.add(d["id"])
            if inbox_tags & set(d.get("tags") or []):
                in_inbox.add(d["id"])
    missing = [i for i in ordered if i not in existing]
    if missing:
        raise Failure("some documents do not exist; nothing was written", missing=missing[:50])
    known = load_confirmed()
    new = [i for i in ordered if i not in known and i not in in_inbox]
    ctx.step("checked", requested=len(ordered), new=len(new), already_confirmed=len([i for i in ordered if i in known]),
             skipped_inbox=sorted(in_inbox))
    if new and not a.dry_run:
        CACHE.mkdir(exist_ok=True)
        with open(CONFIRMED, "a") as f:
            f.writelines(f"{i}\n" for i in new)
    ctx.set(dry_run=a.dry_run, logged=[] if a.dry_run else new, would_log=new if a.dry_run else [],
            skipped_inbox=sorted(in_inbox), list=str(CONFIRMED))


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    sc = sub.add_parser("scan")
    sc.add_argument("--confirm-type", action="append", help="also skip documents of this type (repeatable)")
    sc.add_argument("--min-known", type=float, default=0.55, help="known-word ratio below which text is flagged")
    sc.add_argument("--report", help="write the flagged list here instead of ocr-cache/flagged.csv")
    ok = sub.add_parser("ok")
    ok.add_argument("ids", nargs="*", help="ids or ranges, e.g. 35 53 57-80")
    ok.add_argument("--tag", help="also log every document currently carrying this tag")
    ok.add_argument("--type", help="also log every document of this document type")
    ok.add_argument("--dry-run", action="store_true", help="report what would be logged and write nothing")
    argv = sys.argv[1:]
    if not argv or argv[0].startswith("-"):
        argv = ["scan"] + argv
    a = ap.parse_args(argv)
    fn = {"scan": cmd_scan, "ok": cmd_ok}[a.cmd]
    Context(f"ocr-scan {a.cmd}", **{k: v for k, v in vars(a).items() if k != "cmd"}).run(lambda ctx: fn(ctx, a))


if __name__ == "__main__":
    main()
