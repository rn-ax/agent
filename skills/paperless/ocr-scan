#!/usr/bin/env python3
"""Find Paperless documents with bad OCR through the REST API (read-only; no tags).

    ocr-scan [scan] [--no-save] [--rescan] [--min-known 0.55] [--ignore-type NAME ...] [--report FILE]
    ocr-scan ok ID|A-B ...      record documents you verified as fine

`scan` fetches every document, scores the stored OCR text and lists the ones that fail in
ocr-cache/flagged.csv. It never writes to Paperless: no tags, no edits. The cache is the
work queue; `ok` takes documents off it.

Heuristics, all language-agnostic and computed on the `content` field (a document is
flagged when any fails; every reason is reported):
  no_text           under 20 characters (plain-text documents are exempt)
  broken_encoding   control characters above 2% of the text (a shifted embedded text layer;
                    needs PAPERLESS_OCR_MODE=redo to fix)
  unknown_words     at least 15 letter tokens and known_ratio below --min-known, where
                    known_ratio is the share of tokens (3+ letters) that occur in at least
                    3 other documents. Real words repeat across a library, OCR garbage doesn't.
  thin_text         under 15 tokens and under 150 characters per page
  fragmented        over 60% of the letter-bearing words have 2 letters or fewer (20+ words):
                    spaced-out letters such as "Samue l Valen t i n", which known_ratio misses
Documents of an ignored type (default "Pyssel / Teckning": drawings rarely have text)
are never scored.

State lives in ocr-cache/ next to this script (gitignored, local to this machine):
  verified.jsonl   append-only, last record per id wins: {id, status, source, content_sha, h, at}.
                   source "human" (from `ok`) holds as long as the text is unchanged; source
                   "auto" (passed the heuristics) is also invalidated when the heuristics change.
  cursor.json      {last_id, last_run}: documents above last_id are "new" in the summary.
  flagged.csv      the latest list of failing documents.
Every run fetches all text, because known_ratio compares a document with the whole library.

Credentials: PAPERLESS_URL and PAPERLESS_TOKEN, else the "Paperless" item in the "Agent"
1Password vault (first URL = LAN address, password = API token), like pl-api.
"""
import argparse
import csv
import datetime
import collections
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
CACHE = HERE / "ocr-cache"
VERIFIED = CACHE / "verified.jsonl"
CURSOR = CACHE / "cursor.json"
FLAGGED = CACHE / "flagged.csv"

HEURISTICS_VERSION = 1  # bump when a rule changes: invalidates "auto" cache entries
DEFAULT_IGNORE_TYPES = ["Pyssel / Teckning"]
MIN_DF = 3
PAGE_SIZE = 100
CHUNK = 200
FIELDS = "id,title,content,page_count,mime_type,document_type"

TOKEN_RE = re.compile(r"[^\W\d_]{3,}", re.U)
CTRL_RE = re.compile(r"[\x00-\x08\x0b\x0d-\x1f]")


# --- API ------------------------------------------------------------------

def credentials():
    url, token = os.environ.get("PAPERLESS_URL"), os.environ.get("PAPERLESS_TOKEN")
    if url and token:
        return url.rstrip("/"), token
    wrapper = os.path.expanduser("~/tasks/op-service-account")
    out = subprocess.run([wrapper, "item", "get", "Paperless", "--vault", "Agent",
                          "--format", "json", "--reveal"], capture_output=True, text=True)
    if out.returncode:
        sys.exit(f"could not read the Paperless item from 1Password: {out.stderr.strip()[:200]}")
    item = json.loads(out.stdout)
    token = token or next(f["value"] for f in item["fields"] if f["id"] == "password")
    url = url or item["urls"][0]["href"]
    return url.rstrip("/"), token


URL, TOKEN = None, None


def api(method, path, body=None):
    req = urllib.request.Request(
        URL + "/api" + path, method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={"Authorization": f"Token {TOKEN}", "Accept": "application/json; version=9",
                 "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=180) as r:
            return json.loads(r.read() or "null")
    except urllib.error.HTTPError as e:
        sys.exit(f"{method} {path}: HTTP {e.code} {e.read()[:300]!r}")


def fetch_documents():
    docs, page = [], 1
    while True:
        qs = urllib.parse.urlencode({"page": page, "page_size": PAGE_SIZE, "ordering": "id", "fields": FIELDS})
        data = api("GET", f"/documents/?{qs}")
        docs += data["results"]
        if not data.get("next"):
            return docs
        page += 1


def type_ids(names):
    types = {t["name"].casefold(): t["id"]
             for t in api("GET", "/document_types/?page_size=1000")["results"]}
    ids = set()
    for n in names:
        if n.casefold() in types:
            ids.add(types[n.casefold()])
        else:
            print(f"warning: ignored document type {n!r} does not exist (renamed?)", file=sys.stderr)
    return ids


# --- scoring --------------------------------------------------------------

def sha(text):
    return hashlib.sha1(text.encode()).hexdigest()[:16]


def score(doc, df, min_known):
    text = doc.get("content") or ""
    n = len(text.strip())
    pages = max(doc.get("page_count") or 1, 1)
    toks = [t.lower() for t in TOKEN_RE.findall(text)]
    own = set(toks)
    known = sum(1 for t in toks if df[t] - (1 if t in own else 0) >= MIN_DF)
    ratio = known / len(toks) if toks else 0.0
    ctrl = len(CTRL_RE.findall(text)) / max(len(text), 1)
    words = [w for w in text.split() if any(c.isalpha() for c in w)]
    frag = sum(1 for w in words if sum(c.isalpha() for c in w) <= 2) / len(words) if words else 0.0
    reasons = []
    if doc.get("mime_type") != "text/plain":
        if n < 20:
            reasons.append("no_text")
        else:
            if ctrl > 0.02:
                reasons.append("broken_encoding")
            if len(toks) >= 15 and ratio < min_known:
                reasons.append("unknown_words")
            if len(toks) < 15 and n / pages < 150:
                reasons.append("thin_text")
            if len(words) >= 20 and frag > 0.6:
                reasons.append("fragmented")
    return dict(reasons=reasons, known_ratio=round(ratio, 3), tokens=len(toks), chars=n,
                chars_per_page=round(n / pages), ctrl=round(ctrl, 4), frag=round(frag, 3))


# --- state ----------------------------------------------------------------

def load_verified():
    state = {}
    if VERIFIED.exists():
        for line in VERIFIED.read_text().splitlines():
            if line.strip():
                rec = json.loads(line)
                state[rec["id"]] = rec
    return state


def append_verified(records):
    CACHE.mkdir(exist_ok=True)
    with open(VERIFIED, "a") as f:
        for r in records:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")


def load_cursor():
    return json.loads(CURSOR.read_text()) if CURSOR.exists() else {"last_id": 0, "last_run": None}


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


# --- commands -------------------------------------------------------------

def cmd_scan(args):
    ignored_types = type_ids(DEFAULT_IGNORE_TYPES + (args.ignore_type or []))
    print("fetching documents ...", file=sys.stderr)
    docs = fetch_documents()
    df = collections.Counter()
    for d in docs:
        df.update(set(t.lower() for t in TOKEN_RE.findall(d.get("content") or "")))
    verified, cursor = load_verified(), load_cursor()

    ignored = skipped_human = skipped_auto = new_docs = 0
    flagged, new_good = [], []
    for d in docs:
        is_new = d["id"] > cursor["last_id"]
        new_docs += is_new
        if d.get("document_type") in ignored_types:
            ignored += 1
            continue
        digest = sha(d.get("content") or "")
        rec = verified.get(d["id"])
        if rec and rec.get("status") == "good" and rec.get("content_sha") == digest:
            if rec.get("source") == "human":
                skipped_human += 1
                continue
            if rec.get("h") == HEURISTICS_VERSION and not args.rescan:
                skipped_auto += 1
                continue
        s = score(d, df, args.min_known)
        if s["reasons"]:
            flagged.append({"id": d["id"], "title": d["title"], "new": int(is_new),
                            "reasons": "+".join(s["reasons"]), **{k: v for k, v in s.items() if k != "reasons"}})
        else:
            new_good.append({"id": d["id"], "status": "good", "source": "auto",
                             "content_sha": digest, "h": HEURISTICS_VERSION, "at": now()})

    print(f"\n{len(docs)} documents | {ignored} ignored by type | {skipped_human} verified by you | "
          f"{skipped_auto} cached as good | {new_docs} new since id {cursor['last_id']}")
    print(f"scored {len(flagged) + len(new_good)}: {len(new_good)} pass, {len(flagged)} flagged")
    by_reason = collections.Counter(r for f in flagged for r in f["reasons"].split("+"))
    for r, c in by_reason.most_common():
        print(f"  {r}: {c}")
    print(f"  newly flagged documents (id above cursor): {sum(f['new'] for f in flagged)}")

    report = Path(args.report) if args.report else FLAGGED
    if not args.no_save:
        CACHE.mkdir(exist_ok=True)
        append_verified(new_good)
        CURSOR.write_text(json.dumps({"last_id": max(d["id"] for d in docs), "last_run": now()}) + "\n")
    report.parent.mkdir(parents=True, exist_ok=True)
    cols = ["id", "title", "reasons", "new", "known_ratio", "tokens", "chars", "chars_per_page", "ctrl", "frag"]
    with open(report, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=cols)
        w.writeheader()
        w.writerows(flagged)
    print(f"flagged list: {report}" + ("" if not args.no_save else "  (state not saved: --no-save)"))


def parse_ids(items):
    ids = set()
    for item in items:
        for part in item.split(","):
            a, _, b = part.partition("-")
            ids.update(range(int(a), int(b or a) + 1))
    return sorted(ids)


def cmd_ok(args):
    records = []
    for i in parse_ids(args.ids):
        d = api("GET", f"/documents/{i}/")
        records.append({"id": i, "status": "good", "source": "human",
                        "content_sha": sha(d.get("content") or ""), "at": now()})
    append_verified(records)
    print(f"recorded {len(records)} documents as verified")


def main():
    global URL, TOKEN
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    sc = sub.add_parser("scan", help="score every document and list the bad ones (default)")
    sc.add_argument("--no-save", action="store_true", help="do not update the local cache or cursor")
    sc.add_argument("--rescan", action="store_true", help="re-score documents cached as auto-good")
    sc.add_argument("--min-known", type=float, default=0.55, help="known-token ratio below which text is flagged")
    sc.add_argument("--ignore-type", action="append", help="also ignore this document type (repeatable)")
    sc.add_argument("--report", help="write the flagged list here instead of ocr-cache/flagged.csv")
    ok = sub.add_parser("ok", help="mark documents as verified good")
    ok.add_argument("ids", nargs="+", help="ids or ranges, e.g. 35 53 57-80")
    argv = sys.argv[1:]
    if not argv or argv[0].startswith("-"):
        argv = ["scan"] + argv
    args = ap.parse_args(argv)
    URL, TOKEN = credentials()
    {"scan": cmd_scan, "ok": cmd_ok}[args.cmd](args)


if __name__ == "__main__":
    main()
