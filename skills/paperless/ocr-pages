#!/usr/bin/env python3
"""Helpers for fixing a document's OCR text by reading its pages yourself.

    ocr-pages prep ID [ID ...] [--dpi 130] [--no-trim]
        Back up the current text, download the original, render an overview PNG per page. The
        render uses the PDF's crop box and is trimmed to the content, because an image view costs
        by pixel area and a receipt sits in a corner of an A4 page. Pages can differ in size.
    ocr-pages strips ID PAGE [--dpi 200] [--height 700]
        Cut one page into full-width, overlapping strips for reading small or blurry text. About
        2,100 x 700 px stays legible on a smudged scan; the Read tool downsizes anything larger than
        about 2,000 px, so a whole page is too small for fine print.
    ocr-pages crop ID PAGE X Y W H [--dpi 200]
        Crop a region; X Y W H are PIXELS at --dpi (points * dpi / 72).
    ocr-pages rotate ID PAGE DEGREES
        Rotate a page's overview PNG (90 = clockwise; macOS sips) for scans stored sideways;
        text running down the page needs 270.
    ocr-pages put ID TEXTFILE [--dry-run]
        Replace the document's text with TEXTFILE and read it back. The only command that
        writes to Paperless, and it writes only the text: change tags with pl-tags.
    ocr-pages next [--n 10] [--min-pages A] [--max-pages B]
        Documents still tagged ocr-bad, fewest pages first.

View the PNGs with an image viewer (Claude: the Read tool), transcribe into a text file, then `put`.

Every command prints one JSON context on stdout (inputs, each step done, the paths and ids the next
step needs) and exits 0, or 1 with an `error` in the context saying which step failed and what had
been done by then. Scratch files live in $CLAUDE_JOB_DIR/tmp/paperless-ocr/ID (else the system temp
dir); the first backup of a document is never overwritten, so it holds the text from before any
change. Needs pdfinfo and pdftoppm (poppler).
"""
import argparse
import glob
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from paperless_lib import Api, Context, Failure

FLAG_TAG = "ocr-bad"


def state_dir():
    base = Path(os.environ["CLAUDE_JOB_DIR"]) / "tmp" if os.environ.get("CLAUDE_JOB_DIR") else Path(tempfile.gettempdir())
    d = base / "paperless-ocr"
    d.mkdir(parents=True, exist_ok=True)
    return d


def workdir(doc_id):
    d = state_dir() / str(doc_id)
    d.mkdir(parents=True, exist_ok=True)
    return d


def run(cmd, what):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        raise Failure(f"{what} failed", command=cmd[0], stderr=r.stderr.strip()[-300:])
    return r.stdout


def page_sizes(pdf):
    out = run(["pdfinfo", "-f", "1", "-l", "9999", str(pdf)], "pdfinfo")
    return {int(n): (float(w), float(h)) for n, w, h in re.findall(r"Page\s+(\d+) size:\s+([\d.]+) x ([\d.]+) pts", out)}


def render(pdf, root, dpi, page, extra=()):
    for old in glob.glob(f"{root}*.png"):
        os.remove(old)
    run(["pdftoppm", "-q", "-cropbox", "-r", str(dpi), "-png", "-f", str(page), "-l", str(page), *extra, str(pdf), str(root)], "pdftoppm")
    found = sorted(glob.glob(f"{root}*.png"))
    if not found:
        raise Failure("pdftoppm produced no image", page=page)
    return found[0]


def content_box(pdf, page, w_pt, h_pt, margin=18):
    """Bounding box (points) of the non-white area from a 40 dpi greyscale render, ignoring specks
    and edge lines; None when the content fills most of the page. Image views cost by pixel area, so
    reading the trimmed render is much cheaper for a receipt in the corner of an A4 page."""
    root = Path(tempfile.mkdtemp()) / "probe"
    run(["pdftoppm", "-q", "-cropbox", "-r", "40", "-gray", "-f", str(page), "-l", str(page), str(pdf), str(root)], "pdftoppm probe")
    data = Path(glob.glob(f"{root}*.pgm")[0]).read_bytes()
    m = re.match(rb"P5\s+(\d+)\s+(\d+)\s+255\s", data)
    w, h, px = int(m.group(1)), int(m.group(2)), data[m.end():]
    xs, ys = [], []
    for y in range(h):
        row = px[y * w:(y + 1) * w]
        for x, v in enumerate(row):
            if v < 235:
                xs.append(x)
                ys.append(y)
    if len(xs) < 20:
        return None
    xs.sort()
    ys.sort()
    lo, hi = int(len(xs) * 0.003), int(len(xs) * 0.997) - 1
    k = 72 / 40
    x0, x1 = max(0, xs[lo] * k - margin), min(w_pt, (xs[hi] + 1) * k + margin)
    y0, y1 = max(0, ys[lo] * k - margin), min(h_pt, (ys[hi] + 1) * k + margin)
    return None if (x1 - x0) * (y1 - y0) > 0.8 * w_pt * h_pt else (x0, y0, x1, y1)


def need_pdf(doc_id):
    pdf = workdir(doc_id) / "original.pdf"
    if not pdf.exists():
        raise Failure(f"no downloaded original for #{doc_id}", hint=f"run: ocr-pages prep {doc_id}")
    return pdf


# --- commands ---------------------------------------------------------------

def prep_one(api, a, doc_id):
    d = workdir(doc_id)
    out = {"id": doc_id}
    try:
        meta = api.get(f"/documents/{doc_id}/")
        backup = d / "backup.json"
        out["backup"] = {"path": str(backup), "kept_earlier_backup": backup.exists()}
        if not backup.exists():
            backup.write_text(json.dumps(meta, ensure_ascii=False))
            backup.chmod(0o600)
        out.update(title=meta["title"], pages=meta.get("page_count"), mime=meta["mime_type"],
                   existing_text_chars=len(meta.get("content") or ""))
        is_pdf = meta["mime_type"] == "application/pdf"
        ext = {"application/pdf": "pdf", "image/jpeg": "jpg", "image/png": "png", "image/tiff": "tif"}.get(meta["mime_type"], "bin")
        original = d / f"original.{ext}"
        size = api.download(f"/documents/{doc_id}/download/?original=true", original)
        out["original"] = {"path": str(original), "bytes": size}
        if not is_pdf:
            out["note"] = "not a PDF: view the original directly"
            return out
        out["pages_rendered"] = []
        for p, (w, h) in page_sizes(original).items():
            box = None if a.no_trim else content_box(original, p, w, h)
            extra = () if not box else ("-x", str(int(box[0] * a.dpi / 72)), "-y", str(int(box[1] * a.dpi / 72)),
                                        "-W", str(int((box[2] - box[0]) * a.dpi / 72)), "-H", str(int((box[3] - box[1]) * a.dpi / 72)))
            out["pages_rendered"].append({"page": p, "width_pt": round(w), "height_pt": round(h),
                                          "trimmed_to_pt": None if not box else [round(box[2] - box[0]), round(box[3] - box[1])],
                                          "png": render(original, d / f"page{p}", a.dpi, p, extra)})
    except Failure as e:
        out["error"] = {"message": str(e), **e.detail}
    return out


def cmd_prep(ctx, a):
    api = Api()
    docs = [prep_one(api, a, i) for i in a.ids]
    ctx.set(docs=docs)
    failed = [d["id"] for d in docs if "error" in d]
    if failed:
        raise Failure(f"{len(failed)} of {len(docs)} documents could not be prepared", failed=failed)


def cmd_strips(ctx, a):
    pdf = need_pdf(a.id)
    w_pt, h_pt = page_sizes(pdf)[a.page]
    w_px, h_px = int(w_pt * a.dpi / 72), int(h_pt * a.dpi / 72)
    ctx.step("page_size", width_px=w_px, height_px=h_px, dpi=a.dpi)
    paths, y = [], 0
    while y < h_px:
        paths.append(render(pdf, workdir(a.id) / f"strip{a.page}_{len(paths) + 1}", a.dpi, a.page,
                            ("-x", "0", "-y", str(y), "-W", str(w_px), "-H", str(min(a.height, h_px - y)))))
        y += a.height - 60
    ctx.set(strips=paths)


def cmd_crop(ctx, a):
    pdf = need_pdf(a.id)
    ctx.set(png=render(pdf, workdir(a.id) / f"crop{a.page}_{a.x}_{a.y}", a.dpi, a.page,
                       ("-x", str(a.x), "-y", str(a.y), "-W", str(a.w), "-H", str(a.h))))


def cmd_rotate(ctx, a):
    src = [f for f in sorted(glob.glob(str(workdir(a.id) / f"page{a.page}-*.png"))) if "rot" not in Path(f).name]
    if not src:
        raise Failure(f"no overview image for page {a.page}", hint=f"run: ocr-pages prep {a.id}")
    out = workdir(a.id) / f"page{a.page}-rot{a.degrees}.png"
    run(["sips", "-r", str(a.degrees), src[0], "--out", str(out)], "sips")
    ctx.set(png=str(out))


def cmd_put(ctx, a):
    text = Path(a.textfile).read_text()
    if not text.strip():
        raise Failure("the text file is empty; nothing was written", textfile=a.textfile)
    api = Api()
    meta = api.get(f"/documents/{a.id}/")
    backup = workdir(a.id) / "backup.json"
    if not backup.exists():
        backup.write_text(json.dumps(meta, ensure_ascii=False))
        backup.chmod(0o600)
    ctx.step("checked", backup=str(backup), stored_chars=len(meta.get("content") or ""), new_chars=len(text))
    if a.dry_run:
        ctx.set(dry_run=True, written=False)
        return
    api.request("PATCH", f"/documents/{a.id}/", {"content": text})
    ctx.step("patched")
    stored = api.get(f"/documents/{a.id}/").get("content") or ""
    verified = stored.strip() == text.strip()
    ctx.set(dry_run=False, written=True, verified=verified, stored_chars=len(stored))
    if not verified:
        raise Failure("the stored text differs from what was sent", sent_chars=len(text), stored_chars=len(stored))


def cmd_next(ctx, a):
    api = Api()
    flag = api.tag(FLAG_TAG)
    docs = api.documents(f"tags__id__all={flag['id']}", "id,title,page_count")
    pool = [d for d in docs if a.min_pages <= (d["page_count"] or 1) <= a.max_pages]
    pool.sort(key=lambda d: ((d["page_count"] or 1), d["id"]))
    ctx.set(tagged=len(docs), remaining=len(pool),
            candidates=[{"id": d["id"], "pages": d["page_count"], "title": d["title"][:80]} for d in pool[:a.n]])


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("prep"); p.add_argument("ids", type=int, nargs="+"); p.add_argument("--dpi", type=int, default=130); p.add_argument("--no-trim", action="store_true"); p.set_defaults(f=cmd_prep)
    p = sub.add_parser("strips"); p.add_argument("id", type=int); p.add_argument("page", type=int); p.add_argument("--dpi", type=int, default=200); p.add_argument("--height", type=int, default=700); p.set_defaults(f=cmd_strips)
    p = sub.add_parser("crop"); p.add_argument("id", type=int); p.add_argument("page", type=int)
    for n in "xywh":
        p.add_argument(n, type=int)
    p.add_argument("--dpi", type=int, default=200); p.set_defaults(f=cmd_crop)
    p = sub.add_parser("rotate"); p.add_argument("id", type=int); p.add_argument("page", type=int); p.add_argument("degrees", type=int); p.set_defaults(f=cmd_rotate)
    p = sub.add_parser("put"); p.add_argument("id", type=int); p.add_argument("textfile"); p.add_argument("--dry-run", action="store_true"); p.set_defaults(f=cmd_put)
    p = sub.add_parser("next"); p.add_argument("--n", type=int, default=10); p.add_argument("--min-pages", type=int, default=1); p.add_argument("--max-pages", type=int, default=10**6); p.set_defaults(f=cmd_next)
    a = ap.parse_args()
    args = {k: v for k, v in vars(a).items() if k != "f"}
    Context(f"ocr-pages {a.cmd}", **args).run(lambda ctx: a.f(ctx, a))


if __name__ == "__main__":
    main()
