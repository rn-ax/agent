#!/usr/bin/env bash
# Authenticated Windmill REST API wrapper, using this account's Windmill
# token, base URL, and workspace (the "Windmill" item in the "Claude"
# 1Password vault).
# Usage: wm-api <method> <path> [curl-args...]
#   wm-api GET /scripts/list?per_page=3
#   wm-api POST /jobs/run_wait_result/f/reminders/invoice_email -d '{"from": "..."}'
#
# <path> is relative to <base_url>/api/w/<workspace> and must start with /.
set -euo pipefail

method="${1:?Usage: wm-api <method> <path> [curl-args...]}"
path="${2:?Usage: wm-api <method> <path> [curl-args...]}"
shift 2

base_url="$(~/tasks/op-service-account item get Windmill --vault Claude --fields "label=base url" --reveal)"
workspace="$(~/tasks/op-service-account item get Windmill --vault Claude --fields "label=workspace" --reveal)"
token="$(~/tasks/op-service-account item get Windmill --vault Claude --fields label=password --reveal)"

curl -sS -X "$method" "${base_url}/api/w/${workspace}${path}" \
	-H "Authorization: Bearer $token" \
	-H "Content-Type: application/json" \
	"$@"
