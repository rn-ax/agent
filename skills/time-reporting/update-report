#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer>=0.15,<1"]
# ///
"""update-report --date YYYY-MM-DD --type TYPE [--start HH:MM --end HH:MM]

Read and validate data/time-reports.jsonl, atomically add or replace one
approved daily report, then atomically refresh the Übersicht freshness badge.
Work records require start and end times; non-work types must omit them. Emits
one JSON context object on every path. Exit 0 on success, 1 on ledger, badge,
or file errors, and 2 on invalid report arguments.
"""

from __future__ import annotations

import json
import os
import tempfile
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from typing import Any

import typer


REPORT_PATH = Path(__file__).resolve().parents[2] / "data" / "time-reports.jsonl"
BADGE_PATH = Path.home() / ".config/ubersicht/badges/time-reporting.json"
FIELDS = {"date", "start_time", "end_time", "type"}
TYPES = {"work", "non-working day", "sick", "vacation", "flex"}
app = typer.Typer(add_completion=False, invoke_without_command=True)


def validate_entry(entry: Any, *, source: str) -> dict[str, str | None]:
    if not isinstance(entry, dict) or set(entry) != FIELDS:
        raise ValueError(f"{source} must contain exactly {', '.join(sorted(FIELDS))}")
    try:
        parsed_date = date.fromisoformat(entry["date"])
    except (TypeError, ValueError) as exc:
        raise ValueError(f"{source} has an invalid ISO date") from exc
    if parsed_date.isoformat() != entry["date"]:
        raise ValueError(f"{source} date must use YYYY-MM-DD")
    day_type = entry["type"]
    if not isinstance(day_type, str) or day_type not in TYPES:
        raise ValueError(f"{source} type must be one of: {', '.join(sorted(TYPES))}")
    start = entry["start_time"]
    end = entry["end_time"]
    if day_type == "work":
        start_value = parse_time(start, f"{source} start_time")
        end_value = parse_time(end, f"{source} end_time")
        if start_value >= end_value:
            raise ValueError(f"{source} start_time must be earlier than end_time")
    elif start is not None or end is not None:
        raise ValueError(f"{source} start_time and end_time must be null for {day_type}")
    return {"date": parsed_date.isoformat(), "start_time": start, "end_time": end, "type": day_type}


def parse_time(value: Any, label: str) -> datetime:
    if not isinstance(value, str):
        raise ValueError(f"{label} must use HH:MM")
    try:
        parsed = datetime.strptime(value, "%H:%M")
    except ValueError as exc:
        raise ValueError(f"{label} must use HH:MM") from exc
    if parsed.strftime("%H:%M") != value:
        raise ValueError(f"{label} must use HH:MM")
    return parsed


def read_ledger() -> list[dict[str, str | None]]:
    if not REPORT_PATH.exists():
        return []
    entries: list[dict[str, str | None]] = []
    seen: set[str] = set()
    for line_number, line in enumerate(REPORT_PATH.read_text(encoding="utf-8").splitlines(), start=1):
        if not line.strip():
            continue
        try:
            entry = validate_entry(json.loads(line), source=f"line {line_number}")
        except (json.JSONDecodeError, ValueError) as exc:
            raise ValueError(f"Invalid ledger line {line_number}: {exc}") from exc
        if entry["date"] in seen:
            raise ValueError(f"Duplicate date in ledger: {entry['date']}")
        seen.add(str(entry["date"]))
        entries.append(entry)
    return entries


def write_ledger(entries: list[dict[str, str | None]]) -> None:
    REPORT_PATH.parent.mkdir(parents=True, exist_ok=True)
    payload = "".join(json.dumps(entry, separators=(",", ":"), ensure_ascii=False) + "\n" for entry in entries)
    descriptor, temporary_path = tempfile.mkstemp(prefix=f".{REPORT_PATH.name}.", dir=REPORT_PATH.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(payload)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary_path, REPORT_PATH)
    except BaseException:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass
        raise


def utc_timestamp(value: datetime) -> str:
    return value.isoformat(timespec="seconds").replace("+00:00", "Z")


def write_badge(payload: dict[str, Any]) -> None:
    BADGE_PATH.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_path = tempfile.mkstemp(prefix=f".{BADGE_PATH.name}.", dir=BADGE_PATH.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(payload, output, separators=(",", ":"))
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary_path, BADGE_PATH)
    except BaseException:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass
        raise


@app.callback()
def main(
    date_arg: str = typer.Option(..., "--date", help="Helsinki report date (YYYY-MM-DD)"),
    day_type: str = typer.Option(..., "--type", help="One of: work, non-working day, sick, vacation, flex"),
    start: str | None = typer.Option(None, "--start", help="Work start time (HH:MM); required for work"),
    end: str | None = typer.Option(None, "--end", help="Work end time (HH:MM); required for work"),
) -> None:
    ctx: dict[str, Any] = {
        "script": "update-report",
        "args": {
            "date": date_arg,
            "type": day_type,
            "start_time": start,
            "end_time": end,
            "report_path": str(REPORT_PATH),
            "badge_path": str(BADGE_PATH),
        },
        "steps": [],
    }
    exit_code = 0
    validation_complete = False
    active_step = "validate_report"
    try:
        try:
            parsed_date = date.fromisoformat(date_arg)
        except ValueError as exc:
            raise ValueError("--date must use YYYY-MM-DD") from exc
        if parsed_date.isoformat() != date_arg:
            raise ValueError("--date must use YYYY-MM-DD")
        proposed = validate_entry(
            {"date": date_arg, "start_time": start, "end_time": end, "type": day_type},
            source="requested report",
        )
        validation_complete = True
        active_step = "read_ledger"
        entries = read_ledger()
        ctx["steps"].append({"step": "read_ledger", "entry_count": len(entries)})
        replaced = any(entry["date"] == date_arg for entry in entries)
        entries = [entry for entry in entries if entry["date"] != date_arg]
        entries.append(proposed)
        entries.sort(key=lambda entry: str(entry["date"]), reverse=True)
        active_step = "write_ledger"
        write_ledger(entries)
        ctx["steps"].append({"step": "write_ledger", "replaced_existing_date": replaced})
        active_step = "verify_ledger"
        verified = read_ledger()
        saved = next((entry for entry in verified if entry["date"] == date_arg), None)
        if saved != proposed:
            raise RuntimeError("Read-back did not match the requested report")
        ctx["steps"].append({"step": "verify_ledger", "verified": True})
        ctx["record"] = saved
        active_step = "write_badge"
        now = datetime.now(timezone.utc).replace(microsecond=0)
        badge = {
            "lastRun": utc_timestamp(now),
            "staleAt": utc_timestamp(now + timedelta(days=5)),
            "icon": "ci:calendar-check",
            "color": "#30d158",
            "staleIcon": "ci:calendar-close",
            "staleColor": "#ff3b30",
        }
        write_badge(badge)
        ctx["steps"].append({"step": "write_badge", "path": str(BADGE_PATH)})
        active_step = "verify_badge"
        saved_badge = json.loads(BADGE_PATH.read_text(encoding="utf-8"))
        if saved_badge != badge:
            raise RuntimeError("Badge read-back did not match the written values")
        ctx["steps"].append({"step": "verify_badge", "verified": True})
        ctx["badge"] = saved_badge
    except (OSError, RuntimeError, ValueError) as exc:
        ctx["error"] = {
            "step": active_step,
            "type": type(exc).__name__,
            "message": str(exc),
        }
        exit_code = 2 if isinstance(exc, ValueError) and not validation_complete else 1
    except Exception as exc:
        ctx["error"] = {
            "step": active_step,
            "type": type(exc).__name__,
            "message": str(exc),
        }
        exit_code = 1
    finally:
        print(json.dumps(ctx, ensure_ascii=False, separators=(",", ":")))
    if exit_code:
        raise typer.Exit(code=exit_code)


if __name__ == "__main__":
    app()
