#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer>=0.15,<1"]
# ///
"""refresh-report-badge

Write the approved-report freshness state to
~/.config/ubersicht/badges/time-reporting.json and verify it by reading it back.
The file is atomically replaced. Emits one JSON context object on every path.
Exit 0 on success and 1 on write or verification failure.
"""

from __future__ import annotations

import json
import os
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

import typer


BADGE_PATH = Path.home() / ".config/ubersicht/badges/time-reporting.json"
app = typer.Typer(add_completion=False, invoke_without_command=True)


def utc_timestamp(value: datetime) -> str:
    return value.isoformat(timespec="seconds").replace("+00:00", "Z")


def write_badge(payload: dict[str, Any]) -> None:
    BADGE_PATH.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_path = tempfile.mkstemp(prefix=f".{BADGE_PATH.name}.", dir=BADGE_PATH.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(payload, output, separators=(",", ":"))
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary_path, BADGE_PATH)
    except BaseException:
        try:
            os.unlink(temporary_path)
        except FileNotFoundError:
            pass
        raise


@app.callback()
def main() -> None:
    ctx: dict[str, Any] = {
        "script": "refresh-report-badge",
        "args": {"badge_path": str(BADGE_PATH)},
        "steps": [],
    }
    exit_code = 0
    try:
        now = datetime.now(timezone.utc).replace(microsecond=0)
        payload = {
            "lastRun": utc_timestamp(now),
            "nextRunDue": utc_timestamp(now + timedelta(days=7)),
            "icon": "ci:calendar-check",
            "color": "#30d158",
            "staleIcon": "ci:calendar-close",
            "staleColor": "#ff3b30",
        }
        write_badge(payload)
        ctx["steps"].append({"step": "write_badge", "path": str(BADGE_PATH)})
        saved = json.loads(BADGE_PATH.read_text(encoding="utf-8"))
        if saved != payload:
            raise RuntimeError("Badge read-back did not match the written values")
        ctx["steps"].append({"step": "verify_badge", "verified": True})
        ctx["badge"] = saved
    except Exception as exc:
        ctx["error"] = {
            "step": ctx["steps"][-1]["step"] if ctx["steps"] else "write_badge",
            "type": type(exc).__name__,
            "message": str(exc),
        }
        exit_code = 1
    finally:
        print(json.dumps(ctx, ensure_ascii=False, separators=(",", ":")))
    if exit_code:
        raise typer.Exit(code=exit_code)


if __name__ == "__main__":
    app()
