#!/usr/bin/env bash
# Register a repo as a HACS custom repository and install it, via HA's
# websocket API (HACS doesn't expose this over the REST API).
# Usage: hacs-install <owner/repo> <category>
#   category is HACS's lowercase category name, e.g. "integration"
set -euo pipefail

repo="${1:?Usage: hacs-install <owner/repo> <category>}"
category="${2:?Usage: hacs-install <owner/repo> <category>}"

skill_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
venv_dir="$skill_dir/.venv"

if [ ! -d "$venv_dir" ]; then
  python3 -m venv "$venv_dir"
  "$venv_dir/bin/pip" install -q websockets
fi

HOME_ASSISTANT_TOKEN=$(grep '^HOME_ASSISTANT_TOKEN=' ~/.config/home-assistant/env | cut -d= -f2-)
HOME_ASSISTANT_URL=$(grep '^HOME_ASSISTANT_URL=' ~/.config/home-assistant/env | cut -d= -f2-)
export HOME_ASSISTANT_TOKEN HOME_ASSISTANT_URL

"$venv_dir/bin/python3" "$skill_dir/hacs_install.py" "$repo" "$category"
